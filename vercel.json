{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    }
  },
  "env": {
    "ENCRYPTION_KEY": "@ENCRYPTION_KEY",
    "CLOUDFLARE_KEY": "@CLOUDFLARE_KEY",
    "EXA_KEY": "@EXA_KEY",
    "GOOGLE_KEY": "@GOOGLE_KEY",
    "GROQ_KEY": "@GROQ_KEY",
    "HUGGINGFACE_KEY": "@HUGGINGFACE_KEY",
    "LLMTR_KEY": "@LLMTR_KEY",
    "NVIDIA_KEY": "@NVIDIA_KEY",
    "OPENROUTER_KEY": "@OPENROUTER_KEY",
    "ORCAROUTER_KEY": "@ORCAROUTER_KEY",
    "PARALLEL_KEY": "@PARALLEL_KEY",
    "ROUTEWAY_KEY": "@ROUTEWAY_KEY",
    "SIMPLELLM_KEY": "@SIMPLELLM_KEY",
    "SPEECHIFY_KEY": "@SPEECHIFY_KEY",
    "TAVILY_KEY": "@TAVILY_KEY",
    "XKIRO_KEY": "@XKIRO_KEY"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/v1beta/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/livez",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
